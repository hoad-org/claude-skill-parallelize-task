# Staging Environment Configuration
# Used for pre-production testing and validation

# Application
APP_ENV=staging
DEBUG=false
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database
DATABASE_URL=postgresql://user:password@db.staging:5432/parallelizer
REDIS_URL=redis://redis.staging:6379/0

# Security
SECRET_KEY=${STAGING_SECRET_KEY}
ALLOWED_HOSTS=staging.example.com,api.staging.example.com

# Features
ENABLE_METRICS=true
ENABLE_LOGGING=true
ENABLE_TRACING=true

# Limits
REQUEST_TIMEOUT=60
MAX_WORKERS=8
BATCH_SIZE=500

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9091

# Task Configuration
TASK_TIMEOUT=600
MAX_PARALLEL_TASKS=50
RETRY_ATTEMPTS=5
RETRY_BACKOFF=3

# API Configuration
API_VERSION=v1
API_TITLE=Parallelizer Task Scheduler
API_DESCRIPTION=Intelligent task parallelization and dependency analysis

# Cache
CACHE_ENABLED=true
CACHE_TTL=7200

# CORS
CORS_ORIGINS=["https://staging.example.com","https://api.staging.example.com"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","PUT","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# Email Notifications
EMAIL_ENABLED=true
SMTP_SERVER=${STAGING_SMTP_SERVER}
SMTP_PORT=587
SMTP_USERNAME=${STAGING_SMTP_USERNAME}
SMTP_PASSWORD=${STAGING_SMTP_PASSWORD}
NOTIFICATION_EMAIL=staging-alerts@example.com

# Slack Integration
SLACK_ENABLED=true
SLACK_WEBHOOK_URL=${STAGING_SLACK_WEBHOOK}

# AWS
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=${STAGING_AWS_ACCESS_KEY}
AWS_SECRET_ACCESS_KEY=${STAGING_AWS_SECRET_KEY}

# Deployment Tracking
DEPLOYMENT_TRACKING_ENABLED=true
DEPLOYMENT_WEBHOOK_URL=https://api.staging.example.com/webhooks/deployment

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_PERIOD=3600
