# Production Environment Configuration
# CRITICAL: All secrets must be managed via AWS Secrets Manager or similar

# Application
APP_ENV=production
DEBUG=false
LOG_LEVEL=WARNING

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=16

# Database
DATABASE_URL=postgresql://user:password@db.production:5432/parallelizer_prod
REDIS_URL=redis://redis-cluster.production:6379/0

# Security
SECRET_KEY=${PRODUCTION_SECRET_KEY}
ALLOWED_HOSTS=parallelizer.example.com,api.parallelizer.example.com

# Features
ENABLE_METRICS=true
ENABLE_LOGGING=true
ENABLE_TRACING=true

# Limits
REQUEST_TIMEOUT=120
MAX_WORKERS=16
BATCH_SIZE=1000

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9091
DATADOG_ENABLED=true
DATADOG_API_KEY=${PRODUCTION_DATADOG_KEY}

# Task Configuration
TASK_TIMEOUT=3600
MAX_PARALLEL_TASKS=200
RETRY_ATTEMPTS=10
RETRY_BACKOFF=5

# API Configuration
API_VERSION=v1
API_TITLE=Parallelizer Task Scheduler
API_DESCRIPTION=Intelligent task parallelization and dependency analysis

# Cache
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_BACKEND=redis

# CORS
CORS_ORIGINS=["https://parallelizer.example.com","https://api.parallelizer.example.com"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","PUT","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# Email Notifications
EMAIL_ENABLED=true
SMTP_SERVER=${PRODUCTION_SMTP_SERVER}
SMTP_PORT=587
SMTP_USERNAME=${PRODUCTION_SMTP_USERNAME}
SMTP_PASSWORD=${PRODUCTION_SMTP_PASSWORD}
NOTIFICATION_EMAIL=alerts@example.com

# Slack Integration
SLACK_ENABLED=true
SLACK_WEBHOOK_URL=${PRODUCTION_SLACK_WEBHOOK}

# AWS
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=${PRODUCTION_AWS_ACCESS_KEY}
AWS_SECRET_ACCESS_KEY=${PRODUCTION_AWS_SECRET_KEY}
AWS_S3_BUCKET=parallelizer-prod-artifacts

# Deployment Tracking
DEPLOYMENT_TRACKING_ENABLED=true
DEPLOYMENT_WEBHOOK_URL=https://api.parallelizer.example.com/webhooks/deployment

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=10000
RATE_LIMIT_PERIOD=3600

# Authentication
AUTH_ENABLED=true
JWT_SECRET=${PRODUCTION_JWT_SECRET}
JWT_EXPIRY=3600

# Security Headers
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
CSP_POLICY=default-src 'self'

# Backup & Disaster Recovery
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=parallelizer-prod-backups

# Compliance
COMPLIANCE_MODE=true
AUDIT_LOGGING_ENABLED=true
GDPR_ENABLED=true
DATA_RETENTION_DAYS=90

# Load Balancing
LOAD_BALANCER=application
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5

# Circuit Breaker
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_THRESHOLD=50
CIRCUIT_BREAKER_TIMEOUT=60
