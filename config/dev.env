# Development Environment Configuration
# Used for local development and testing

# Application
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

# Server
HOST=127.0.0.1
PORT=8000
WORKERS=1

# Database
DATABASE_URL=sqlite:///./dev.db
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=dev-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Features
ENABLE_METRICS=true
ENABLE_LOGGING=true
ENABLE_TRACING=false

# Limits
REQUEST_TIMEOUT=30
MAX_WORKERS=4
BATCH_SIZE=100

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9091

# Task Configuration
TASK_TIMEOUT=300
MAX_PARALLEL_TASKS=10
RETRY_ATTEMPTS=3
RETRY_BACKOFF=2

# API Configuration
API_VERSION=v1
API_TITLE=Parallelizer Task Scheduler
API_DESCRIPTION=Intelligent task parallelization and dependency analysis

# Cache
CACHE_ENABLED=true
CACHE_TTL=3600

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","PUT","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# Email (for notifications, optional)
EMAIL_ENABLED=false
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Slack Integration (optional)
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=

# AWS (optional)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
