# Multi-stage Dockerfile for Parallelize-Task Dashboard
# Stage 1: Builder - compile frontend with Node.js
FROM node:20-alpine as builder

WORKDIR /build

# Copy package files
COPY frontend/package*.json ./

# Install dependencies
RUN npm ci --only=production && \
    npm install

# Copy frontend source
COPY frontend/ ./

# Build the Vue.js application
RUN npm run build

# Stage 2: Runtime - serve with nginx
FROM nginx:alpine

# Metadata
LABEL maintainer="Claude Code <claude@anthropic.com>"
LABEL description="Parallelize-Task Web Dashboard"
LABEL version="1.1.0"

# Create non-root user for nginx
RUN addgroup -g 1000 -S nginx-app && \
    adduser -S -G nginx-app -u 1000 -h /var/cache/nginx nginx-app

# Copy built application from builder
COPY --from=builder --chown=nginx-app:nginx-app /build/dist /usr/share/nginx/html

# Configure nginx
RUN mkdir -p /etc/nginx/conf.d && \
    rm /etc/nginx/conf.d/default.conf

COPY docker/nginx.conf /etc/nginx/nginx.conf
COPY docker/default.conf /etc/nginx/conf.d/default.conf

# Create necessary directories with correct permissions
RUN mkdir -p /var/run/nginx /var/cache/nginx && \
    chown -R nginx-app:nginx-app /var/run/nginx /var/cache/nginx /var/log/nginx && \
    touch /var/log/nginx/access.log /var/log/nginx/error.log && \
    chown nginx-app:nginx-app /var/log/nginx/access.log /var/log/nginx/error.log

# Switch to non-root user
USER nginx-app

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget -q -O- http://localhost:3000 || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
