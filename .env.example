# Environment Template for Parallelizer Task Skill
# Copy to .env and fill in actual values for your deployment
# WARNING: Never commit .env with real values to version control

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================

# Environment name (dev, staging, production)
PARALLELIZER_ENV=production

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
PARALLELIZER_LOG_LEVEL=INFO

# Data directory for persistence
PARALLELIZER_DATA_DIR=/app/data

# ==============================================================================
# API CONFIGURATION
# ==============================================================================

# API host binding
API_HOST=0.0.0.0

# API port
API_PORT=8000

# API workers (number of worker processes)
API_WORKERS=4

# API token for authentication
API_TOKEN=change-me-in-production

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================

# Redis connection URL
REDIS_URL=redis://:redis-password@redis:6379/0

# Redis host (if using separate from URL)
REDIS_HOST=redis

# Redis port
REDIS_PORT=6379

# Redis password
REDIS_PASSWORD=redis-password

# Redis database number
REDIS_DB=0

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

# Database type (postgres, mysql, sqlite)
DB_TYPE=postgres

# Database host
DB_HOST=localhost

# Database port
DB_PORT=5432

# Database user
DB_USER=parallelizer

# Database password
DB_PASSWORD=change-me-in-production

# Database name
DB_NAME=parallelizer

# Database URL (alternative to above)
DATABASE_URL=postgresql://parallelizer:change-me-in-production@localhost:5432/parallelizer

# ==============================================================================
# MONITORING & OBSERVABILITY
# ==============================================================================

# Enable monitoring
PARALLELIZER_MONITORING_ENABLED=true

# Metrics port
PARALLELIZER_METRICS_PORT=9090

# Prometheus endpoint
PROMETHEUS_URL=http://prometheus:9090

# Prometheus scrape interval (seconds)
PROMETHEUS_SCRAPE_INTERVAL=15

# Grafana API endpoint
GRAFANA_API_URL=http://grafana:3000

# Grafana API key
GRAFANA_API_KEY=change-me-in-production

# ==============================================================================
# PERFORMANCE TUNING
# ==============================================================================

# Maximum parallel tasks
MAX_PARALLEL_TASKS=100

# Task timeout (seconds)
TASK_TIMEOUT=3600

# Cache TTL (seconds)
CACHE_TTL=3600

# Checkpoint interval (seconds)
CHECKPOINT_INTERVAL=300

# Optimization level (1-3, higher = more optimization)
OPTIMIZATION_LEVEL=3

# ==============================================================================
# FEATURE FLAGS
# ==============================================================================

# DAG analysis enabled
FEATURE_DAG_ANALYSIS=true

# Parallel execution enabled
FEATURE_PARALLEL_EXECUTION=true

# Performance optimization enabled
FEATURE_PERFORMANCE_OPTIMIZATION=true

# Distributed caching enabled
FEATURE_DISTRIBUTED_CACHING=true

# Monitoring export enabled
FEATURE_MONITORING_EXPORT=true

# Remote persistence enabled
FEATURE_REMOTE_PERSISTENCE=false

# ==============================================================================
# EXTERNAL SERVICES
# ==============================================================================

# AWS configuration
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1
AWS_S3_BUCKET=parallelizer-state

# GitHub integration
GITHUB_TOKEN=ghp_change-me-in-production
GITHUB_USER=github-username

# Datadog monitoring
DATADOG_API_KEY=dd_api_key_change-me-in-production
DATADOG_APP_KEY=dd_app_key_change-me-in-production

# Sentry error tracking
SENTRY_DSN=https://key@sentry.io/project-id

# ==============================================================================
# DOCKER & KUBERNETES
# ==============================================================================

# Docker image registry
DOCKER_REGISTRY=docker.io

# Docker image name
DOCKER_IMAGE_NAME=parallelizer

# Docker image tag
DOCKER_IMAGE_TAG=latest

# Kubernetes namespace
K8S_NAMESPACE=default

# Kubernetes cluster context
K8S_CONTEXT=default

# ==============================================================================
# LOGGING & DIAGNOSTICS
# ==============================================================================

# Log format (text, json)
LOG_FORMAT=json

# Log output (stdout, file, both)
LOG_OUTPUT=stdout

# Log file path (if LOG_OUTPUT includes file)
LOG_FILE=/app/logs/parallelizer.log

# Debug mode (enables verbose logging)
DEBUG=false

# ==============================================================================
# SECURITY
# ==============================================================================

# Enable TLS/SSL
ENABLE_TLS=true

# TLS certificate path
TLS_CERT_PATH=/etc/parallelizer/tls/tls.crt

# TLS key path
TLS_KEY_PATH=/etc/parallelizer/tls/tls.key

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=https://example.com,https://api.example.com

# CORS allowed methods
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS

# ==============================================================================
# RATE LIMITING & QUOTAS
# ==============================================================================

# Rate limit requests per second
RATE_LIMIT_RPS=100

# Request timeout (seconds)
REQUEST_TIMEOUT=300

# Max request body size (MB)
MAX_REQUEST_SIZE=100

# ==============================================================================
# BACKUP & RECOVERY
# ==============================================================================

# Enable automated backups
BACKUP_ENABLED=false

# Backup schedule (cron format)
BACKUP_SCHEDULE=0 2 * * *

# Backup retention (days)
BACKUP_RETENTION=30

# Backup storage location
BACKUP_STORAGE=s3://backups
